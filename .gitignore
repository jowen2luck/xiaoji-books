__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# === Node / 前端 ===
node_modules/

# === IDE / 编辑器 ===
.vscode/
.idea/
*.swp
*.swo
*~

# === OS 垃圾 ===
.DS_Store
Thumbs.db
